engine-strict=true
package-manager-strict=true
strict-peer-dependencies=true
auto-install-peers=false
ignore-scripts=true
verify-store-integrity=true
prefer-frozen-lockfile=true
minimum-release-age=1440
save-exact=true

minimum-release-age-exclude[]=@velum-labs/model-fusion-protocol
minimum-release-age-exclude[]=next
minimum-release-age-exclude[]=fumadocs-core
minimum-release-age-exclude[]=fumadocs-mdx
minimum-release-age-exclude[]=fumadocs-ui
minimum-release-age-exclude[]=tailwindcss
minimum-release-age-exclude[]=@tailwindcss/postcss
minimum-release-age-exclude[]=lucide-react
minimum-release-age-exclude[]=@types/mdx
minimum-release-age-exclude[]=@types/react-dom
minimum-release-age-exclude[]=react-dom
