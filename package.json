{
  "name": "routekit-monorepo",
  "private": true,
  "description": "RouteKit: configure, serve, and use model gateways for coding agents.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11.15.1"
  },
  "scripts": {
    "check": "node scripts/check-repo.mjs",
    "lint": "biome lint .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "build": "node scripts/run-turbo.mjs run build",
    "build:cli": "node scripts/run-turbo.mjs run build --filter=@velum-labs/routekit...",
    "clean": "node scripts/run-turbo.mjs run clean",
    "test": "PORTLESS=0 node scripts/run-turbo.mjs run test && corepack pnpm run test:root",
    "test:root": "PORTLESS=0 node --test \"test/*.test.js\" \"scripts/test/*.test.mjs\"",
    "test:routekit-pack": "node scripts/check-routekit-cli-pack.mjs",
    "test:self-update:matrix": "node scripts/self-update-manager-matrix.mjs",
    "test:e2e:matrix": "node scripts/run-turbo.mjs run build --filter=@velum-labs/routekit... --filter=@velum-labs/routekit-testkit... && node scripts/routekit-e2e-matrix.mjs",
    "test:e2e:eval-routing:live": "node scripts/run-turbo.mjs run build --filter=@velum-labs/routekit-testkit... && node scripts/routekit-eval-routing-testdrive.mjs",
    "dev:link-routekit": "node scripts/link-routekit-dev.mjs",
    "dev:run-routekit": "node scripts/routekit-dev.mjs",
    "t3:deploy": "node scripts/t3-routekit-deploy.mjs",
    "t3:destroy": "node scripts/t3-routekit-destroy.mjs",
    "docs:generate-code": "typedoc --options typedoc.json",
    "docs:generate-public-changelog": "node scripts/docs/generate-public-changelog.mjs",
    "docs:generate-agent-manifests": "corepack pnpm build:cli && node scripts/docs/generate-agent-manifests.mjs",
    "docs:check-agent-manifests": "corepack pnpm build:cli && node scripts/docs/generate-agent-manifests.mjs --check",
    "docs:dev": "corepack pnpm --filter @velum-labs/routekit-docs dev",
    "docs:build": "corepack pnpm --filter @velum-labs/routekit-docs build",
    "docs:start": "corepack pnpm --filter @velum-labs/routekit-docs start",
    "docs:generate-routekit-evidence": "node scripts/generate-routekit-l06-evidence.mjs",
    "docs:check-routekit-evidence": "node scripts/generate-routekit-l06-evidence.mjs --check",
    "docs:generate-client-support": "node scripts/generate-routekit-client-support.mjs",
    "docs:check-client-support": "node scripts/generate-routekit-client-support.mjs --check",
    "changeset": "changeset",
    "version-packages": "changeset version && corepack pnpm docs:generate-public-changelog",
    "syncpack:lint": "syncpack lint",
    "depcruise": "depcruise packages --config .dependency-cruiser.mjs",
    "package:lint": "node scripts/check-publishable-packages.mjs --publint",
    "package:types": "node scripts/check-publishable-packages.mjs --attw",
    "api:report": "node scripts/check-public-api-reports.mjs",
    "api:report:check": "node scripts/check-public-api-reports.mjs --check",
    "release:artifacts": "node scripts/generate-release-artifacts.mjs",
    "release:registry:preflight": "node scripts/check-npm-release-registry.mjs names",
    "release:registry:verify": "node scripts/check-npm-release-registry.mjs versions",
    "release": "corepack pnpm release:registry:preflight && corepack pnpm check && corepack pnpm build && node scripts/check-routekit-cli-pack.mjs && corepack pnpm package:lint && corepack pnpm package:types && corepack pnpm test && changeset publish && corepack pnpm release:registry:verify",
    "verify": "corepack pnpm check && corepack pnpm build && corepack pnpm package:lint && corepack pnpm package:types && corepack pnpm test",
    "verify:ci": "corepack pnpm check && corepack pnpm depcruise && corepack pnpm build && corepack pnpm api:report:check && corepack pnpm package:lint && corepack pnpm package:types && corepack pnpm test",
    "test:remote:docker": "node scripts/routekit-remote-docker-e2e.mjs",
    "test:remote:docker:helpers": "node --test scripts/test/remote-docker-e2e.test.mjs",
    "tsgo:patch": "corepack pnpm --dir tooling/tsgo exec effect-tsgo patch --typescript"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "effect": "catalog:",
    "publint": "catalog:",
    "syncpack": "catalog:",
    "turbo": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typescript": "catalog:"
  }
}
