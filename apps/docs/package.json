{
  "name": "@velum-labs/routekit-docs",
  "private": true,
  "version": "0.1.0",
  "description": "RouteKit documentation site (Fumadocs + Next.js).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/docs/generate-public-changelog.mjs --check && node ../../scripts/docs/generate-llms.mjs && node ../../scripts/docs/check-model-references.mjs && fumadocs-mdx && next dev --port 3000",
    "build": "node ../../scripts/docs/generate-public-changelog.mjs --check && node ../../scripts/docs/generate-llms.mjs && node ../../scripts/docs/check-model-references.mjs && fumadocs-mdx && next build",
    "start": "next start --port 3000",
    "types:check": "node ../../scripts/docs/generate-public-changelog.mjs --check && node ../../scripts/docs/generate-llms.mjs && node ../../scripts/docs/check-model-references.mjs && fumadocs-mdx && tsc --noEmit"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "catalog:",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "fumadocs-ui": "catalog:",
    "lucide-react": "catalog:",
    "mermaid": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
