    "onboarding:optimization:routekit:repair:manifest": "node cli/generate-onboarding-optimization-routekit-repair-manifest.mjs",
    "onboarding:optimization:routekit:final:prepare": "node cli/prepare-onboarding-optimization-routekit-final.mjs",
    "onboarding:optimization:routekit:final:manifest": "node cli/generate-onboarding-optimization-routekit-final-manifest.mjs",
    "runner:build": "vercel vcr build docker . routekit-experiment-runner:coding-router --push -- -f apps/experiment-platform/Dockerfile.coding-router-runner",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "catalog:",
    "@vercel/blob": "catalog:",
    "@vercel/queue": "catalog:",
    "@vercel/sandbox": "catalog:",
    "@velum-labs/routekit-eval-contracts": "workspace:*",
    "@velum-labs/routekit-eval-core": "workspace:*",
    "@velum-labs/routekit-eval-store": "workspace:*",
    "effect": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "workflow": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
