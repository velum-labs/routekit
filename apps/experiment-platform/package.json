{
  "name": "@velum-labs/routekit-experiment-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Vercel control plane for reproducible RouteKit experiments.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build",
    "start": "next start --port 3010",
    "cli": "node cli/experiment-cli.mjs",
    "cloud:check": "node cli/cloud-preflight.mjs",
    "gateway:canary": "node cli/gateway-model-canary.mjs",
    "assets:freeze": "node cli/freeze-coding-router-assets.mjs",
    "assets:upload": "node cli/upload-frozen-assets.mjs",
    "inputs:prepare": "node cli/prepare-luna-task-inputs.mjs",
    "inputs:upload": "node cli/upload-luna-task-inputs.mjs",
    "manifests:generate": "node cli/generate-luna-manifests.mjs",
    "composition:prepare": "node cli/prepare-composition-task-inputs.mjs",
    "composition:upload": "node cli/upload-composition-task-inputs.mjs",
    "composition:manifests": "node cli/generate-composition-manifests.mjs",
    "taxonomy:prepare": "node cli/prepare-area-taxonomy-pilot.mjs",
    "taxonomy:upload": "node cli/upload-area-taxonomy-pilot.mjs",
    "taxonomy:manifests": "node cli/generate-area-taxonomy-pilot-manifests.mjs",
    "taxonomy:aggregate": "node cli/aggregate-area-taxonomy-pilot.mjs",
    "onboarding:construction:prepare": "node cli/prepare-onboarding-followup-construction.mjs",
    "onboarding:inventory:upload": "node cli/upload-onboarding-followup-inventory.mjs",
    "onboarding:construction:manifests": "node cli/generate-onboarding-followup-construction-manifests.mjs",
    "onboarding:evaluations:prepare": "node cli/prepare-onboarding-followup-evaluations.mjs",
    "onboarding:evaluations:manifests": "node cli/generate-onboarding-followup-evaluation-manifests.mjs",
    "onboarding:evaluations:aggregate": "node cli/aggregate-onboarding-followup-evaluations.mjs",
    "onboarding:generalization:collect": "node cli/collect-onboarding-generalization-data.mjs",
    "onboarding:generalization:construction:prepare": "node cli/prepare-onboarding-generalization-construction.mjs",
    "onboarding:generalization:construction:manifests": "node cli/generate-onboarding-generalization-construction-manifests.mjs",
    "onboarding:generalization:neutral-retry:prepare": "node cli/prepare-onboarding-generalization-neutral-retry.mjs",
    "onboarding:generalization:neutral-retry:manifest": "node cli/generate-onboarding-generalization-neutral-retry-manifest.mjs",
    "onboarding:generalization:evaluation:prepare": "node cli/prepare-onboarding-generalization-evaluation.mjs",
    "onboarding:generalization:evaluation:manifests": "node cli/generate-onboarding-generalization-evaluation-manifests.mjs",
    "onboarding:generalization:aggregate": "node cli/aggregate-onboarding-generalization.mjs",
    "onboarding:optimization:construction:prepare": "node cli/prepare-onboarding-optimization-construction.mjs",
    "onboarding:optimization:construction:manifests": "node cli/generate-onboarding-optimization-construction-manifests.mjs",
    "onboarding:optimization:neutral:prepare": "node cli/prepare-onboarding-optimization-neutral.mjs",
    "onboarding:optimization:neutral:manifests": "node cli/generate-onboarding-optimization-neutral-manifests.mjs",
    "onboarding:optimization:validation:prepare": "node cli/prepare-onboarding-optimization-validation.mjs",
    "onboarding:optimization:validation:manifests": "node cli/generate-onboarding-optimization-validation-manifests.mjs",
    "onboarding:optimization:repair:prepare": "node cli/select-and-prepare-onboarding-optimization-repair.mjs",
    "onboarding:optimization:repair:manifest": "node cli/generate-onboarding-optimization-repair-manifest.mjs",
    "onboarding:optimization:final:prepare": "node cli/prepare-onboarding-optimization-final.mjs",
    "onboarding:optimization:final:manifests": "node cli/generate-onboarding-optimization-final-manifests.mjs",
    "onboarding:optimization:cohorts:prepare": "node cli/prepare-onboarding-optimization-cohorts.mjs",
    "onboarding:optimization:cohorts:manifests": "node cli/generate-onboarding-optimization-cohort-manifests.mjs",
