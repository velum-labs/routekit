{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".npmrc", "pnpm-lock.yaml", "tsconfig.base.json"],
  "globalEnv": ["CI"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", "tsconfig.tsbuildinfo"] },
    "test": { "dependsOn": ["build"], "cache": false, "env": ["PORTLESS"] },
    "lint": { "cache": true },
    "clean": { "cache": false },
    "dev": { "cache": false, "persistent": true }
  }
}
