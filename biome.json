{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!docs/generated",
      "!apps/docs/.next",
      "!apps/docs/.source",
      "!apps/docs/generated",
      "!apps/docs/content/docs/api",
      "!pnpm-lock.yaml",
      "!packages/eval-engine/src/vendor",
      "!packages/eval-engine/test/standalone",
      "!packages/eval-engine/assets/sdk/*.js",
      "!packages/eval-engine/src/sdk/*.js.txt"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "suspicious": {
        "noConsole": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/cli/src/**/*.ts",
        "packages/cli-core/src/**/*.ts",
        "packages/cli-ui/src/**/*.ts",
        "packages/cli-ui/src/**/*.tsx",
        "!**/test/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    }
  ]
}
