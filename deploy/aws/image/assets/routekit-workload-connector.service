[Unit]
Description=RouteKit memory-only workload credential connector
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service

[Service]
Type=simple
User=root
Group=root
Environment=ROUTEKIT_WORKLOAD_CONNECTOR_CONFIG=/etc/routekit-runtime/connector.json
ExecStart=/opt/node/bin/node /opt/routekit-runtime/workload/dist/connector-main.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadOnlyPaths=/etc/routekit-runtime/connector.json

[Install]
WantedBy=multi-user.target
