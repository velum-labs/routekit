[Unit]
Description=RouteKit immutable runtime supervisor and readiness gate
Wants=network-online.target routekit-runtime-log-forwarder.service
After=network-online.target routekit-runtime-log-forwarder.service
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
Environment=ROUTEKIT_RUNTIME_MANIFEST_PUBLIC_KEY=/opt/routekit-runtime/manifest-signing-public.pem
ExecStart=/opt/node/bin/node /opt/routekit-runtime/workload/dist/supervisor-main.js
Restart=on-failure
RestartSec=15
# The supervisor must create a user-owned T3 systemd unit. The child command
# drops to the dedicated service user; the unit itself remains root-owned.
NoNewPrivileges=false
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
