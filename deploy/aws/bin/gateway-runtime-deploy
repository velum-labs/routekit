#!/usr/bin/env bash
# shellcheck shell=bash
set -euo pipefail

profile='routekit-admin-terraform'
region='us-west-2'
instance_id=''
release=''
bundle_s3=''
bundle_sha256=''

usage() {
  echo 'usage: gateway-runtime-deploy --instance-id i-... --release X.Y.Z --bundle-s3 s3://.../runtime.tar.gz --sha256 HEX [--profile NAME] [--region REGION]' >&2
  exit 64
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --instance-id) instance_id="${2:-}"; shift 2 ;;
    --release) release="${2:-}"; shift 2 ;;
    --bundle-s3) bundle_s3="${2:-}"; shift 2 ;;
    --sha256) bundle_sha256="${2:-}"; shift 2 ;;
    --profile) profile="${2:-}"; shift 2 ;;
    --region) region="${2:-}"; shift 2 ;;
    *) usage ;;
  esac
done

[[ "$instance_id" =~ ^i-[0-9a-f]+$ ]] || usage
[[ "$release" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || usage
[[ "$bundle_s3" =~ ^s3://[a-z0-9.-]+/sha256/[0-9a-f]{64}/runtime\.tar\.gz$ ]] || usage
[[ "$bundle_sha256" =~ ^[0-9a-f]{64}$ ]] || usage
[[ "$bundle_s3" == *"/sha256/${bundle_sha256}/runtime.tar.gz" ]] || usage
bundle_without_scheme=${bundle_s3#s3://}
bundle_bucket=${bundle_without_scheme%%/*}
bundle_key=${bundle_without_scheme#*/}

repo_root=$(cd "$(dirname "$0")/../../.." && pwd)
unit_b64=$(base64 <"$repo_root/deploy/aws/gateway-broker/assets/routekit-workload-broker.service" | tr -d '\n')
dropin_b64=$(printf '%s\n' \
  '[Service]' \
  'Environment=ROUTEKIT_WORKLOAD_JWT_CONFIG=/etc/routekit/workload-jwt.json' \
  'ExecStart=' \
  "ExecStart=/opt/node/bin/node /opt/routekit-release/${release}/dist/index.js daemon run --config-path /var/lib/routekit/.config/routekit/router.yaml --host 127.0.0.1 --port 8080 --no-portless" |
  base64 | tr -d '\n')

deploy_root="/var/lib/routekit-runtime-deploy/${release}"
runtime_release="/opt/routekit-runtime/releases/${release}"
routekit_release="/opt/routekit-release/${release}"
commands=(
  'set -eu'
  "install -d -m 0700 ${deploy_root}"
  "python3 -c 'import boto3; boto3.client(\"s3\", region_name=\"${region}\").download_file(\"${bundle_bucket}\", \"${bundle_key}\", \"${deploy_root}/runtime.tar.gz\")'"
  "test \"\$(sha256sum ${deploy_root}/runtime.tar.gz | cut -d ' ' -f1)\" = ${bundle_sha256}"
  "rm -rf ${deploy_root}/stage"
  "install -d -m 0700 ${deploy_root}/stage"
  "tar --warning=no-unknown-keyword -xzf ${deploy_root}/runtime.tar.gz -C ${deploy_root}/stage"
  "/opt/node/bin/node --check ${deploy_root}/stage/opt/routekit-runtime/workload/dist/broker-main.js"
  "rm -rf ${runtime_release}.new ${routekit_release}.new"
  'install -d -m 0755 /opt/routekit-runtime/releases /opt/routekit-release /etc/routekit /etc/systemd/system/routekit-gateway.service.d'
  "cp -a ${deploy_root}/stage/opt/routekit-runtime ${runtime_release}.new"
  "cp -a ${deploy_root}/stage/opt/routekit ${routekit_release}.new"
  "if [ -d ${runtime_release} ]; then rm -rf ${runtime_release}.new; else mv ${runtime_release}.new ${runtime_release}; fi"
  "if [ -d ${routekit_release} ]; then rm -rf ${routekit_release}.new; else mv ${routekit_release}.new ${routekit_release}; fi"
  "ln -sfn releases/${release} /opt/routekit-runtime/current.new"
  'mv -Tf /opt/routekit-runtime/current.new /opt/routekit-runtime/current'
  "printf %s ${unit_b64} | base64 -d > /etc/systemd/system/routekit-workload-broker.service"
  "printf %s ${dropin_b64} | base64 -d > /etc/systemd/system/routekit-gateway.service.d/20-workload-jwt.conf"
  'chmod 0644 /etc/systemd/system/routekit-workload-broker.service /etc/systemd/system/routekit-gateway.service.d/20-workload-jwt.conf'
  "python3 -c 'import boto3, os; value=boto3.client(\"ssm\", region_name=\"${region}\").get_parameter(Name=\"/routekit/gateway/production/workload-jwt-config\")[\"Parameter\"][\"Value\"]; fd=os.open(\"/etc/routekit/workload-jwt.json\", os.O_WRONLY|os.O_CREAT|os.O_TRUNC, 0o600); os.write(fd, value.encode()); os.close(fd)'"
  'chown root:routekit /etc/routekit/workload-jwt.json'
  'chmod 0640 /etc/routekit/workload-jwt.json'
  'systemctl daemon-reload'
  'systemctl enable routekit-workload-broker.service'
  'systemctl restart routekit-workload-broker.service'
  'for attempt in $(seq 1 30); do curl -fsS --max-time 5 http://127.0.0.1:8082/health && exit 0; sleep 1; done; exit 1'
)
parameters=$(jq -n --args '$ARGS.positional | {commands: .}' -- "${commands[@]}")
command_id=$(aws ssm send-command \
  --profile "$profile" --region "$region" \
  --document-name AWS-RunShellScript \
  --instance-ids "$instance_id" \
  --parameters "$parameters" \
  --query 'Command.CommandId' --output text)

for _ in $(seq 1 180); do
  status=$(aws ssm get-command-invocation \
    --profile "$profile" --region "$region" \
    --command-id "$command_id" --instance-id "$instance_id" \
    --query Status --output text 2>/dev/null || true)
  case "$status" in
    Success)
      aws ssm get-command-invocation --profile "$profile" --region "$region" \
        --command-id "$command_id" --instance-id "$instance_id" \
        --query '{status:Status,output:StandardOutputContent}' --output json
      exit 0
      ;;
    Failed|Cancelled|TimedOut)
      aws ssm get-command-invocation --profile "$profile" --region "$region" \
        --command-id "$command_id" --instance-id "$instance_id" \
        --query '{status:Status,stdout:StandardOutputContent,stderr:StandardErrorContent}' --output json >&2
      exit 1
      ;;
  esac
  sleep 2
done

echo "SSM command ${command_id} did not finish within six minutes" >&2
exit 1
