{
  "name": "@velum-labs/routekit-control",
  "private": false,
  "version": "1.0.21",
  "description": "Typed control protocol for the singleton RouteKit daemon.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velum-labs/routekit.git",
    "directory": "packages/control"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol-api.d.ts",
      "default": "./dist/protocol-api.js"
    },
    "./registry": {
      "types": "./dist/registry-api.d.ts",
      "default": "./dist/registry-api.js"
    },
    "./effect": {
      "types": "./dist/effect-api.d.ts",
      "default": "./dist/effect-api.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "routekit",
    "daemon",
    "control-protocol",
    "rpc"
  ],
  "dependencies": {
    "@velum-labs/routekit-contracts": "workspace:*",
    "@velum-labs/routekit-eval-contracts": "workspace:*",
    "@velum-labs/routekit-runtime": "workspace:*",
    "@velum-labs/routekit-telemetry-core": "workspace:*",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --test \"dist/test/*.test.js\""
  }
}
