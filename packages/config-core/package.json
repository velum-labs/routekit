{
  "name": "@velum-labs/routekit-config-core",
  "private": false,
  "version": "1.0.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velum-labs/routekit.git",
    "directory": "packages/config-core"
  },
  "description": "RouteKit configuration schemas, parsing, defaults, and model policy.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router-config.d.ts",
      "default": "./dist/router-config.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@velum-labs/routekit-contracts": "workspace:*",
    "zod": "catalog:"
  },
  "keywords": [
    "routekit",
    "configuration",
    "schema"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "node --test \"dist/test/*.test.js\""
  }
}
