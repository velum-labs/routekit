{
  "name": "@velum-labs/routekit-accounts",
  "private": false,
  "version": "1.0.6",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velum-labs/routekit.git",
    "directory": "packages/accounts"
  },
  "description": "Provider subscription credentials, account pools, relays, proxy clients, and managed CLIProxyAPI lifecycle.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pool": {
      "types": "./dist/pool-api.d.ts",
      "default": "./dist/pool-api.js"
    },
    "./relay": {
      "types": "./dist/relay-api.d.ts",
      "default": "./dist/relay-api.js"
    },
    "./effect": {
      "types": "./dist/effect-api.d.ts",
      "default": "./dist/effect-api.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@velum-labs/routekit-contracts": "workspace:*",
    "@velum-labs/routekit-registry": "workspace:*",
    "@velum-labs/routekit-runtime": "workspace:*",
    "effect": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "keywords": [
    "routekit",
    "subscriptions",
    "accounts",
    "proxy"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "node --test \"dist/test/*.test.js\""
  },
  "devDependencies": {
    "@velum-labs/routekit-gateway": "workspace:*"
  }
}
