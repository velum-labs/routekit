{
  "name": "@velum-labs/routekit-testkit",
  "private": true,
  "version": "1.0.0",
  "description": "RouteKit test tooling: provider simulator client, door axis, and process helpers.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@velum-labs/routekit-config": "workspace:*",
    "@velum-labs/routekit-daemon": "workspace:*",
    "@velum-labs/routekit-eval-contracts": "workspace:*",
    "@velum-labs/routekit-eval-core": "workspace:*",
    "@velum-labs/routekit-eval-service": "workspace:*",
    "@velum-labs/routekit-eval-setup": "workspace:*",
    "@velum-labs/routekit-eval-store": "workspace:*",
    "@velum-labs/routekit-gateway": "workspace:*",
    "@velum-labs/routekit-registry": "workspace:*",
    "@velum-labs/routekit-runtime": "workspace:*",
    "effect": "catalog:",
    "yaml": "catalog:"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "node --test \"dist/test/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velum-labs/routekit.git",
    "directory": "packages/testkit"
  }
}
