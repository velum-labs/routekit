{
  "name": "@velum-labs/routekit-gateway",
  "private": false,
  "version": "1.0.21",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velum-labs/routekit.git",
    "directory": "packages/gateway"
  },
  "description": "Product-neutral model router, provider egress, wire dialect translation, streaming, catalog, and call provenance.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol-api.d.ts",
      "default": "./dist/protocol-api.js"
    },
    "./routing": {
      "types": "./dist/routing-api.d.ts",
      "default": "./dist/routing-api.js"
    },
    "./server": {
      "types": "./dist/server-api.d.ts",
      "default": "./dist/server-api.js"
    },
    "./effect": {
      "types": "./dist/effect-api.d.ts",
      "default": "./dist/effect-api.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "catalog:",
    "@aws-sdk/client-bedrock-runtime": "catalog:",
    "@velum-labs/routekit-config-core": "workspace:*",
    "@velum-labs/routekit-contracts": "workspace:*",
    "@velum-labs/routekit-eval-contracts": "workspace:*",
    "@velum-labs/routekit-eval-core": "workspace:*",
    "@velum-labs/routekit-registry": "workspace:*",
    "@velum-labs/routekit-runtime": "workspace:*",
    "effect": "catalog:"
  },
  "keywords": [
    "routekit",
    "llm",
    "coding-agent",
    "gateway",
    "openai-compatible",
    "streaming"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "node --test \"dist/test/*.test.js\""
  }
}
