{
  "name": "@velum-labs/routekit-eval-service",
  "private": false,
  "version": "1.0.22",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velum-labs/routekit.git",
    "directory": "packages/eval-service"
  },
  "description": "Effect composition for RouteKit eval comparisons and routing policy publication.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect-api.d.ts",
      "default": "./dist/effect-api.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@velum-labs/routekit-eval-contracts": "workspace:*",
    "@velum-labs/routekit-eval-engine": "workspace:*",
    "@velum-labs/routekit-eval-store": "workspace:*",
    "@velum-labs/routekit-registry": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:tsgo"
  },
  "keywords": [
    "routekit",
    "eval",
    "routing",
    "effect"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "node --test \"dist/test/*.test.js\""
  }
}
