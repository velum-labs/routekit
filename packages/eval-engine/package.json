{
  "name": "@velum-labs/routekit-eval-engine",
  "version": "0.18.2",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node --experimental-strip-types --experimental-sqlite src/build.ts && pnpm typecheck",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --experimental-strip-types --experimental-sqlite --test --test-timeout=120000 test/production/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "verify-no-bun": "node --experimental-strip-types scripts/verify-no-bun.ts --require-empty",
    "verify": "pnpm typecheck && pnpm verify-no-bun && pnpm test && pnpm build"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:eval-system",
    "@modelcontextprotocol/sdk": "catalog:",
    "@openai/codex": "catalog:eval-system",
    "@openrouter/agent": "catalog:eval-system",
    "@velum-labs/routekit-eval-contracts": "workspace:*",
    "@velum-labs/routekit-runtime": "workspace:*",
    "effect": "catalog:eval-system",
    "esbuild": "catalog:eval-system",
    "fflate": "catalog:eval-system",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:eval-system",
    "typescript": "catalog:tsgo"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "description": "RouteKit workspace integration of the complete standalone evaluation system.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velum-labs/routekit.git",
    "directory": "packages/eval-engine"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist/index.d.ts",
    "dist/index.js",
    "src",
    "skills",
    "test",
    "FEATURE_COMPLETENESS.md",
    "HOST.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "keywords": [
    "routekit",
    "eval",
    "effect",
    "node-test"
  ]
}
