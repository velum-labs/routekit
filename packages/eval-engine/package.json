{
  "name": "@velum-labs/routekit-eval-engine",
  "private": false,
  "version": "0.18.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velum-labs/routekit.git",
    "directory": "packages/eval-engine"
  },
  "description": "Effect-native discovery and node:test execution for RouteKit evaluations.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "ORI_PROVENANCE.json",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "keywords": [
    "routekit",
    "eval",
    "effect",
    "node-test"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "provenance:check": "node scripts/check-provenance.mjs",
    "test": "pnpm provenance:check && node --test \"dist/test/*.test.js\""
  }
}
