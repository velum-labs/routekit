{
  "name": "@velum-labs/routekit-eval-engine",
  "private": false,
  "version": "0.18.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velum-labs/routekit.git",
    "directory": "packages/eval-engine"
  },
  "description": "Complete Effect-native RouteKit Eval library: discovery, execution, gateway harnesses, SDK, authoring, reports, history, and baselines.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "src/vendor",
    "test",
    "docs",
    "LICENSE",
    "NOTICE",
    "UPSTREAM_PROVENANCE.json",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "keywords": [
    "routekit",
    "eval",
    "effect",
    "node-test"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "branding:check": "node scripts/check-branding.mjs",
    "provenance:check": "node scripts/check-vendor-integrity.mjs",
    "test:standalone": "node --experimental-strip-types --experimental-sqlite --test --test-timeout=120000 test/standalone/production/{host-contract,host-env,product-argv,spawn-parsing}.test.ts",
    "test": "pnpm branding:check && pnpm provenance:check && pnpm test:standalone && node --test \"dist/test/*.test.js\""
  }
}
