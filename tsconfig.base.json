{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022"],
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "refactors": true,
        "diagnosticSeverity": {
          "floatingEffect": "error",
          "runEffectInsideEffect": "error",
          "globalFetchInEffect": "error",
          "lazyPromiseInEffectSync": "error",
          "missingReturnYieldStar": "error",
          "globalFetch": "off",
          "globalErrorInEffectFailure": "error",
          "globalErrorInEffectCatch": "warning",
          "tryCatchInEffectGen": "warning"
        },
        "includeSuggestionsInTsc": false,
        "ignoreEffectSuggestionsInTscExitCode": true
      }
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false
  }
}
